# Copier vers .env à la racine du dépôt — ne pas commiter .env
#   copy .env.example .env   (Windows)   |   cp .env.example .env   (Unix)
#
# Maven (mobili-boot) et le bootstrap dotenv remontent les parents pour charger ce fichier.

SPRING_PROFILES_ACTIVE=dev

JWT_SECRET=

FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# mobile_app (client Flutter, pas le backend) — token public Mapbox (pk.*) utilisé à
# l'exécution pour afficher la carte de suivi temps réel, transmis au build via
# --dart-define=MAPBOX_ACCESS_TOKEN=... (jamais commité dans le code Dart).
# Distinct du "downloads token" ci-dessous (secret, scope DOWNLOADS:READ, sert uniquement à
# télécharger le SDK natif Mapbox pendant le build Android/iOS de mobile_app — jamais embarqué
# dans l'app). Les deux sont créés séparément sur https://account.mapbox.com/access-tokens/.
MOBILEAPP_MAPBOX_ACCESS_TOKEN=
MAPBOX_DOWNLOADS_TOKEN=

# Taux fixe EUR/XOF (traité BCEAO/Trésor français) — non sensible, valeur par défaut
# déjà fournie dans application.yml ; à ne changer que si la référence officielle évolue.
PAYMENT_EXCHANGE_XOF_EUR_RATE=655.957

# Postgres local — aligné sur application.yml (localhost:5432/mobili_db par défaut)
DB_USERNAME=postgres
DB_PASSWORD=mobili
